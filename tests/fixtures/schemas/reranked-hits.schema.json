{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dds-loop/rag-reranked-hits/v1",
  "title": "rerank slot reranked hits",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "question_id",
    "chunk_id",
    "parent_id",
    "rank",
    "score",
    "evidence_eligible"
  ],
  "properties": {
    "question_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "chunk_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "parent_id": {
      "type": "string",
      "minLength": 1
    },
    "rank": {
      "type": "integer",
      "minimum": 1
    },
    "score": {
      "type": "number"
    },
    "evidence_eligible": {
      "type": "boolean"
    }
  }
}
